{
  "name": "collabspace",
  "version": "1.0.0",
  "private": true,
  "description": "CoWork Studio — a real-time collaborative workspace built with Next.js, Yjs, TipTap, Redis and PostgreSQL.",
  "scripts": {
    "dev": "concurrently -n web,ws -c cyan,magenta \"next dev\" \"tsx watch server/ws.ts\"",
    "dev:web": "next dev",
    "dev:ws": "tsx watch server/ws.ts",
    "build": "prisma generate && next build",
    "start": "concurrently -n web,ws -c cyan,magenta \"next start\" \"tsx server/ws.ts\"",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:push": "prisma db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "6.19.3",
    "@tiptap/extension-character-count": "2.27.3",
    "@tiptap/extension-code-block-lowlight": "2.27.3",
    "@tiptap/extension-collaboration": "2.27.3",
    "@tiptap/extension-collaboration-cursor": "2.27.3",
    "@tiptap/extension-highlight": "2.27.3",
    "@tiptap/extension-image": "2.27.3",
    "@tiptap/extension-link": "2.27.3",
    "@tiptap/extension-placeholder": "2.27.3",
    "@tiptap/extension-table": "2.27.3",
    "@tiptap/extension-table-cell": "2.27.3",
    "@tiptap/extension-table-header": "2.27.3",
    "@tiptap/extension-table-row": "2.27.3",
    "@tiptap/extension-task-item": "2.27.3",
    "@tiptap/extension-task-list": "2.27.3",
    "@tiptap/extension-text-align": "2.27.3",
    "@tiptap/extension-underline": "2.27.3",
    "@tiptap/pm": "2.27.3",
    "@tiptap/react": "2.27.3",
    "@tiptap/starter-kit": "2.27.3",
    "@tiptap/suggestion": "2.27.3",
    "bcryptjs": "^3.0.2",
    "clsx": "^2.1.1",
    "framer-motion": "12.43.0",
    "ioredis": "^5.9.2",
    "jose": "^6.2.13",
    "lib0": "^0.2.119",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.61.0",
    "next": "15.5.28",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.4.0",
    "tippy.js": "^6.3.7",
    "y-prosemirror": "^1.3.7",
    "y-protocols": "^1.0.7",
    "y-websocket": "^3.1.0",
    "yjs": "^13.6.29",
    "zod": "^4.1.13"
  },
  "devDependencies": {
    "@tailwindcss/typography": "^0.5.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/node": "^24.10.1",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@types/ws": "^8.18.1",
    "autoprefixer": "^10.4.24",
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.39.1",
    "eslint-config-next": "15.5.28",
    "postcss": "^8.5.6",
    "prisma": "6.19.3",
    "tailwindcss": "3.4.19",
    "tailwindcss-animate": "^1.0.7",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vitest": "^4.0.14",
    "ws": "^8.18.3"
  }
}
